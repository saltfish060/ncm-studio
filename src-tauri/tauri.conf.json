{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "NCM Studio",
  "version": "1.0.0",
  "identifier": "com.ncmstudio.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:5173",
    "beforeDevCommand": "npx vite --host 127.0.0.1",
    "beforeBuildCommand": "npm run build:web"
  },
  "app": {
    "windows": [
      {
        "title": "NCM Studio",
        "width": 1180,
        "height": 760,
        "minWidth": 900,
        "minHeight": 620,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "3mber",
    "copyright": "Copyright (c) 2026 3mber · MIT License",
    "shortDescription": "本地把网易云 NCM 文件转成可播放的音频",
    "longDescription": "NCM Studio 桌面版：在本机解密 .ncm 并跟随原格式输出，不联网、不上传任何文件。",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
